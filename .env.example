DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=gpu-booking.example.edu
DATABASE_URL=postgresql://gpu_booking:change-me@/gpu_booking
SITE_URL=https://gpu-booking.example.edu
SITE_TIMEZONE=Asia/Dubai
PAM_SERVICE=gpu-booking
GPU_AUTH_SOCKET=/run/gpu-booking/auth.sock
ADMIN_GROUP=gpu-booking-admins
MIN_INTERACTIVE_UID=1000
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL="Hephaestus <gpu-booking@example.edu>"
GPU_AGENT_POLL_SECONDS=2
GPU_RUNTIME_DIR=/run/gpu-booking
GPU_AGENT_CACHE=/var/lib/gpu-booking/agent-state.json
GPU_ALLOWED_ROOT_PIDS=
GPU_ADMIN_EMAILS=gpu-admins@example.edu
